{
  "schema": "v1",
  "loop": {
    "shape": "refine",
    "maxIterations": 6
  },
  "memory": {
    "store": "litectx",
    "recall": {
      "k": 6,
      "kinds": [
        "code",
        "fact",
        "episode"
      ]
    },
    "compressLevel": "verbatim"
  },
  "hooks": {
    "before-attempt": [
      {
        "op": "recall",
        "k": 6,
        "kinds": [
          "code",
          "fact",
          "episode"
        ]
      },
      {
        "op": "compress",
        "level": "verbatim"
      }
    ],
    "after-red": [
      {
        "op": "stash"
      }
    ],
    "on-green": [
      {
        "op": "remember",
        "kind": "fact"
      }
    ]
  },
  "gate": {
    "budgetUsd": 1,
    "writeScope": [
      "src/**"
    ]
  },
  "escalation": {
    "mode": "decision-ready"
  }
}