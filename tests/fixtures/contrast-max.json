{
  "schema": "v1",
  "loop": { "shape": "refine", "maxIterations": 8 },
  "memory": {
    "store": "litectx",
    "recall": { "k": 20, "kinds": ["fact", "episode"] },
    "compressLevel": "verbatim"
  },
  "hooks": {
    "before-attempt": [
      { "op": "recall", "k": 20, "kinds": ["fact", "episode"] },
      { "op": "compress" }
    ],
    "after-red": [{ "op": "stash" }],
    "on-green": [{ "op": "remember", "kind": "fact" }]
  },
  "gate": { "budgetUsd": 2, "writeScope": ["src/**"] },
  "escalation": { "mode": "decision-ready" }
}
